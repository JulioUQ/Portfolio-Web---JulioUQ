---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ProjectExplorer from '../../components/ProjectExplorer.astro';
import HomeSections from '../../components/HomeSections.astro';
import { site } from '../../content/site';

const lang = 'en';
const t = site[lang];
---

<Base lang={lang} route="home" title={t.meta.title} description={t.meta.description}>
  <Hero lang={lang} />
  <ProjectExplorer lang={lang} />
  <HomeSections lang={lang} />
</Base>
