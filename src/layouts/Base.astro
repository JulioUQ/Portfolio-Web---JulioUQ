---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { languages, routeFor, type Lang, type RouteKey } from '../i18n/routes';
import { site } from '../content/site';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  /** Oculta el botón flotante del chat (p. ej. en la demo del mapa); el chat sigue en la cabecera. */
  hideLauncher?: boolean;
}

const { lang, route, title, description, hideLauncher = false } = Astro.props;
const t = site[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {import.meta.env.PUBLIC_PORTFOLIO_PUBLISHED !== 'true' && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b1f2a" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={routeFor(route, l)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t.ui.skip}</a>
    <Header lang={lang} route={route} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <div class:list={['chat-host', { 'no-launcher': hideLauncher }]}>
      <ChatWidget lang={lang} />
    </div>
  </body>
</html>

<style is:global>
  .chat-host.no-launcher .chat-launcher {
    display: none;
  }
</style>
