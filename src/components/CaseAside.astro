---
/**
 * Ficha e índice de un caso. Se pinta dos veces: como columna lateral en escritorio
 * y dentro de un desplegable en pantallas estrechas. Solo una de las dos es visible
 * (la otra queda con display:none), así que no se duplica para los lectores de pantalla.
 */
import type { CaseContent } from '../content/cases/types';

interface Props {
  c: CaseContent;
  /** Prefijo para que los id no se repitan entre las dos copias. */
  idPrefix: string;
}

const { c, idPrefix } = Astro.props;
const tocId = `${idPrefix}-toc-title`;
const factsId = `${idPrefix}-facts-title`;
---

<div class="facts">
  <h2 id={factsId} class="aside-title">{c.facts.heading}</h2>
  <dl aria-labelledby={factsId}>
    {
      c.facts.items.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd set:html={f.html} />
        </div>
      ))
    }
  </dl>
</div>
<nav class="toc" aria-labelledby={tocId}>
  <h2 id={tocId} class="aside-title">{c.tocHeading}</h2>
  <ol>
    {c.sections.map((s) => <li><a href={`#${s.id}`}>{s.heading}</a></li>)}
    {c.related && <li><a href={`#${c.related.id}`}>{c.related.heading}</a></li>}
  </ol>
</nav>

<style>
  .aside-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .facts {
    padding: 1.1rem 1.1rem 0.6rem;
    background: var(--paper-2);
    border-radius: var(--radius);
  }

  .facts dl {
    margin: 0;
  }

  .facts dt {
    font-weight: 600;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .facts dd {
    margin: 0 0 0.75rem;
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--rule);
  }

  .toc a {
    display: block;
    padding: 0.35rem 0 0.35rem 0.9rem;
    color: var(--ink);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--sea);
    text-decoration: underline;
  }
</style>
