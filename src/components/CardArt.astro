---
/** Miniaturas esquemáticas de las tarjetas (decorativas). */
import type { ProjectArt } from '../content/projects';

interface Props {
  kind: ProjectArt;
}

const { kind } = Astro.props;
---

<svg class="card-art" viewBox="0 0 320 150" aria-hidden="true" focusable="false">
  <rect width="320" height="150" class="bg"></rect>
  {[0, 1, 2, 3].map((i) => <path class="contour" d={`M -10 ${40 + i * 28} C 70 ${20 + i * 28}, 140 ${80 + i * 28}, 330 ${30 + i * 28}`} />)}
  {
    kind === 'halibut' && (
      <g>
        <g class="series">
          <circle cx="58" cy="44" r="7" />
          <circle cx="58" cy="74" r="7" />
          <circle cx="58" cy="104" r="7" />
          <circle cx="58" cy="134" r="7" />
        </g>
        <g class="links">
          <line x1="66" y1="44" x2="232" y2="44" />
          <line x1="66" y1="74" x2="232" y2="74" />
          <line x1="66" y1="104" x2="232" y2="119" />
          <line x1="66" y1="134" x2="232" y2="119" />
        </g>
        <g class="pops">
          <rect x="232" y="34" width="44" height="20" rx="4" />
          <rect x="232" y="64" width="44" height="20" rx="4" />
          <rect x="232" y="104" width="44" height="30" rx="4" class="joined" />
        </g>
        <text x="58" y="22" class="label">y</text>
        <text x="254" y="22" class="label">x</text>
      </g>
    )
  }
  {
    kind === 'map' && (
      <g>
        <rect x="70" y="26" width="150" height="96" rx="4" class="layer l3" />
        <rect x="86" y="18" width="150" height="96" rx="4" class="layer l2" />
        <rect x="102" y="10" width="150" height="96" rx="4" class="layer l1" />
        <path class="poly" d="M120 30 L170 24 L196 50 L176 82 L132 76 Z" />
        <g class="pins">
          <circle cx="214" cy="40" r="5" />
          <circle cx="226" cy="70" r="5" />
          <circle cx="150" cy="92" r="5" />
          <circle cx="206" cy="88" r="5" />
        </g>
        <text x="102" y="136" class="label">.html</text>
      </g>
    )
  }
  {
    kind === 'fleet' && (
      <g>
        <line x1="40" y1="128" x2="290" y2="128" class="axis" />
        {[62, 48, 70, 86, 78, 64, 52, 44, 38, 34].map((h, i) => (
          <rect x={52 + i * 23} y={128 - h} width="14" height={h} class={i > 6 ? 'bar bar-late' : 'bar'} />
        ))}
        <text x="40" y="144" class="label">1987</text>
        <text x="258" y="144" class="label">2025</text>
      </g>
    )
  }
  {
    kind === 'scraping' && (
      <g>
        <rect x="34" y="28" width="74" height="88" rx="4" class="page" />
        {[44, 56, 68, 80, 92, 104].map((y) => <line x1="44" x2="98" y1={y} y2={y} class="row" />)}
        <path d="M118 72 H150" class="arrow" />
        <path d="M144 66 L152 72 L144 78" class="arrow" />
        <rect x="160" y="40" width="44" height="64" rx="4" class="page" />
        {[52, 64, 76, 88].map((y) => <line x1="168" x2="196" y1={y} y2={y} class="row hot" />)}
        <path d="M212 72 H244" class="arrow" />
        <path d="M238 66 L246 72 L238 78" class="arrow" />
        <rect x="254" y="46" width="40" height="52" rx="3" class="csv" />
        <text x="262" y="77" class="label">csv</text>
        <text x="34" y="136" class="label">EU → ESP</text>
      </g>
    )
  }
  {
    kind === 'course' && (
      <g>
        <line x1="40" y1="128" x2="290" y2="128" class="axis" />
        {[6, 13, 38, 76, 120, 96, 60, 30, 12, 5].map((h, i) => (
          <rect x={60 + i * 21} y={128 - h * 0.85} width="16" height={h * 0.85} class="bar" />
        ))}
        <path d="M58 127 C 110 125, 125 22, 168 22 S 230 125, 282 127" class="curve" />
        <line x1="166" y1="128" x2="166" y2="18" class="mean" />
      </g>
    )
  }
  {
    kind === 'platform' && (
      <g>
        {['xlsx', 'n8n', 'SQL', 'py', 'Dash'].map((t, i) => (
          <g>
            <rect x={22 + i * 58} y="52" width="44" height="40" rx="5" class={i === 2 ? 'node db' : 'node'} />
            <text x={44 + i * 58} y="77" class="label" text-anchor="middle">{t}</text>
            {i < 4 && <path d={`M${68 + i * 58} 72 H${78 + i * 58}`} class="arrow" />}
          </g>
        ))}
        <path d="M218 96 V120 H250" class="arrow dashed" />
        <text x="256" y="124" class="label">web</text>
      </g>
    )
  }
  {
    kind === 'clusters' && (
      <g>
        <ellipse cx="96" cy="62" rx="42" ry="30" class="hull" />
        <ellipse cx="214" cy="52" rx="38" ry="26" class="hull" />
        <ellipse cx="166" cy="112" rx="40" ry="24" class="hull alt" />
        {[[80, 55], [96, 70], [110, 52], [88, 80], [118, 68], [74, 66]].map(([x, y]) => <circle cx={x} cy={y} r="4.5" class="pt" />)}
        {[[200, 44], [224, 58], [212, 38], [230, 46], [204, 62]].map(([x, y]) => <circle cx={x} cy={y} r="4.5" class="pt" />)}
        {[[150, 108], [168, 118], [182, 104], [160, 98], [176, 124]].map(([x, y]) => <circle cx={x} cy={y} r="4.5" class="pt hot" />)}
        <text x="34" y="140" class="label">k = 3</text>
      </g>
    )
  }
  {
    kind === 'neural' && (
      <g>
        {[
          [70, [44, 74, 104]],
          [140, [34, 59, 84, 109]],
          [210, [34, 59, 84, 109]],
          [270, [74]],
        ].map(([x, ys], li, layers) =>
          (ys as number[]).map((y) =>
            li < layers.length - 1
              ? (layers[li + 1][1] as number[]).map((y2) => (
                  <line x1={x as number} y1={y} x2={layers[li + 1][0] as number} y2={y2} class="edge" />
                ))
              : null,
          ),
        )}
        {[
          [70, [44, 74, 104]],
          [140, [34, 59, 84, 109]],
          [210, [34, 59, 84, 109]],
        ].map(([x, ys]) => (ys as number[]).map((y) => <circle cx={x as number} cy={y} r="7" class="neuron" />))}
        <circle cx="270" cy="74" r="8" class="neuron out" />
      </g>
    )
  }
  {
    kind === 'dashboard' && (
      <g>
        <rect x="40" y="18" width="240" height="114" rx="6" class="page" />
        <rect x="40" y="18" width="52" height="114" rx="6" class="side" />
        {[34, 50, 66].map((y) => <line x1="50" x2="82" y1={y} y2={y} class="row" />)}
        {[0, 1, 2].map((i) => <rect x={104 + i * 58} y="30" width="50" height="24" rx="3" class={i === 0 ? 'kpi hot' : 'kpi'} />)}
        {[30, 44, 36, 56, 48, 62].map((h, i) => <rect x={108 + i * 16} y={120 - h} width="10" height={h} class="bar" />)}
        <path d="M212 112 L230 96 L246 102 L266 78" class="curve" />
      </g>
    )
  }
  {
    kind === 'spark' && (
      <g>
        <rect x="128" y="18" width="64" height="30" rx="5" class="node db" />
        <text x="160" y="38" class="label" text-anchor="middle">driver</text>
        {[0, 1, 2, 3].map((i) => (
          <g>
            <path d={`M160 48 L${58 + i * 68} 88`} class="arrow" />
            <rect x={34 + i * 68} y="88" width="48" height="34" rx="5" class="node" />
            {[0, 1, 2].map((j) => <rect x={40 + i * 68 + j * 13} y="98" width="9" height="14" class="block" />)}
          </g>
        ))}
        <text x="34" y="142" class="label">HDFS · RDD · DataFrame</text>
      </g>
    )
  }
  {
    kind === 'stream' && (
      <g>
        <line x1="24" y1="70" x2="296" y2="70" class="axis" />
        {[34, 52, 61, 78, 96, 104, 121, 139, 150, 167, 185, 196, 214, 231, 240, 258, 276].map((x, i) => (
          <circle cx={x} cy={70} r="4.5" class={i % 5 === 0 ? 'pt hot' : 'pt'} />
        ))}
        {[24, 116, 208].map((x) => <rect x={x} y="88" width="88" height="34" rx="4" class="window" />)}
        {[24, 116, 208].map((x, i) => (
          <text x={x + 44} y="110" class="label" text-anchor="middle">{`Σ ${[5, 6, 6][i]}`}</text>
        ))}
        <text x="24" y="44" class="label">topic → 60 s</text>
      </g>
    )
  }
  {
    kind === 'story' && (
      <g>
        {[0, 1, 2].map((i) => (
          <g>
            <rect x={30 + i * 92} y="36" width="72" height="72" rx="5" class={i === 2 ? 'page hot-page' : 'page'} />
            <text x={66 + i * 92} y="30" class="label" text-anchor="middle">{`${i + 1}`}</text>
            {i < 2 && <path d={`M${104 + i * 92} 72 H${120 + i * 92}`} class="arrow" />}
          </g>
        ))}
        {[22, 34, 28, 44].map((h, i) => <rect x={40 + i * 14} y={98 - h} width="9" height={h} class="bar" />)}
        <path d="M128 92 L144 76 L158 82 L178 54" class="curve" />
        <circle cx="250" cy="66" r="16" class="pt hot" />
        <path d="M242 66 L248 72 L259 59" class="check" />
      </g>
    )
  }
  {
    kind === 'candles' && (
      <g>
        <line x1="34" y1="128" x2="290" y2="128" class="axis" />
        {[
          [60, 62, 96, 50, 104, true],
          [88, 70, 92, 60, 100, false],
          [116, 54, 74, 44, 82, true],
          [144, 46, 66, 36, 72, true],
          [172, 52, 70, 44, 80, false],
          [200, 38, 58, 28, 64, true],
          [228, 30, 46, 22, 54, true],
          [256, 34, 50, 26, 58, false],
        ].map(([x, top, bottom, high, low, up]) => (
          <g>
            <line x1={x as number} x2={x as number} y1={high as number} y2={low as number} class="wick" />
            <rect x={(x as number) - 7} y={top as number} width="14" height={(bottom as number) - (top as number)} class={up ? 'candle up' : 'candle down'} />
          </g>
        ))}
      </g>
    )
  }
</svg>

<style>
  .card-art {
    display: block;
    width: 100%;
    height: auto;
    /* Misma proporción que las miniaturas con imagen (2:1); el dibujo se centra y los lados quedan en el mismo azul. */
    aspect-ratio: 2 / 1;
    background: var(--navy);
  }

  .bg {
    fill: var(--navy);
  }

  .contour {
    fill: none;
    stroke: var(--navy-line);
    stroke-width: 1.2;
  }

  .series circle {
    fill: var(--sea-soft);
  }

  .links line {
    stroke: var(--on-navy-muted);
    stroke-width: 1.4;
    stroke-dasharray: 4 4;
  }

  .pops rect {
    fill: var(--navy-2);
    stroke: var(--sea-soft);
    stroke-width: 1.5;
  }

  .pops .joined {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--on-navy-muted);
  }

  .layer {
    fill: var(--navy-2);
    stroke: var(--on-navy-muted);
    stroke-opacity: 0.6;
  }

  .l1 {
    fill: #183b4b;
  }

  .poly {
    fill: var(--sea-soft);
    fill-opacity: 0.35;
    stroke: var(--sea-soft);
  }

  .pins circle {
    fill: var(--accent);
  }

  .axis {
    stroke: var(--on-navy-muted);
  }

  .page {
    fill: var(--navy-2);
    stroke: var(--on-navy-muted);
    stroke-opacity: 0.7;
  }

  .row {
    stroke: var(--on-navy-muted);
    stroke-opacity: 0.5;
    stroke-width: 2;
  }

  .row.hot {
    stroke: var(--sea-soft);
    stroke-opacity: 1;
  }

  .arrow {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }

  .arrow.dashed {
    stroke-dasharray: 4 3;
  }

  .csv {
    fill: var(--accent);
    fill-opacity: 0.2;
    stroke: var(--accent);
  }

  .curve {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
  }

  .mean {
    stroke: var(--on-navy-muted);
    stroke-dasharray: 3 4;
  }

  .node {
    fill: var(--navy-2);
    stroke: var(--sea-soft);
    stroke-width: 1.5;
  }

  .node.db {
    stroke: var(--accent);
  }

  .bar {
    fill: var(--sea-soft);
  }

  .bar-late {
    fill: var(--accent);
  }

  .hull {
    fill: var(--sea-soft);
    fill-opacity: 0.12;
    stroke: var(--sea-soft);
    stroke-dasharray: 4 4;
  }

  .hull.alt {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .pt {
    fill: var(--sea-soft);
  }

  .pt.hot {
    fill: var(--accent);
  }

  .edge {
    stroke: var(--on-navy-muted);
    stroke-opacity: 0.45;
    stroke-width: 1;
  }

  .neuron {
    fill: var(--navy-2);
    stroke: var(--sea-soft);
    stroke-width: 2;
  }

  .neuron.out {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .side {
    fill: var(--navy-line);
    fill-opacity: 0.6;
  }

  .kpi {
    fill: var(--navy-2);
    stroke: var(--sea-soft);
  }

  .kpi.hot {
    stroke: var(--accent);
  }

  .block {
    fill: var(--sea-soft);
    fill-opacity: 0.8;
  }

  .window {
    fill: var(--accent);
    fill-opacity: 0.12;
    stroke: var(--accent);
    stroke-dasharray: 4 3;
  }

  .hot-page {
    stroke: var(--accent);
  }

  .check {
    fill: none;
    stroke: var(--navy);
    stroke-width: 3;
  }

  .wick {
    stroke: var(--on-navy-muted);
    stroke-width: 1.5;
  }

  .candle.up {
    fill: var(--sea-soft);
  }

  .candle.down {
    fill: var(--accent);
  }
</style>
