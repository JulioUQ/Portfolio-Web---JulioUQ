---
import ChartIllustration from './ChartIllustration.astro';
import type { Lang } from '../i18n/routes';
import { site } from '../content/site';

interface Props {
  lang: Lang;
}

const t = site[Astro.props.lang];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="name">{t.hero.name}</p>
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="subtitle">{t.hero.subtitle}</p>
      <div class="actions">
        <a class="btn btn-primary" href={`#${t.ids.projects}`}>{t.hero.primary}</a>
        <a class="btn btn-ghost" href={`#${t.ids.background}`}>{t.hero.secondary}</a>
      </div>
    </div>
    <figure class="art">
      <ChartIllustration />
      <figcaption class="visually-hidden">{t.hero.illustrationNote}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 85% 10%, var(--navy-2) 0%, transparent 60%),
      var(--navy);
    color: var(--on-navy);
    /* Compacto: a 1440 × 900 deben verse los títulos de los tres proyectos. */
    padding-block: clamp(1.75rem, 1rem + 2vw, 2.25rem);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .copy {
    position: relative;
    z-index: 1;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1rem;
  }

  h1 {
    font-size: clamp(2rem, 1.4rem + 1.6vw, 2.6rem);
    margin: 0 0 1rem;
    max-width: 36ch;
  }

  .subtitle {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    color: var(--on-navy-muted);
    max-width: 46rem;
    margin: 0 0 1.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* La carta se recorta a una franja baja para no empujar los proyectos fuera de la pantalla. */
  .art {
    margin: 0;
    height: clamp(12rem, 26vh, 15rem);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .art :global(svg) {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* En móvil la carta queda como fondo tenue detrás del texto. */
    .art {
      position: absolute;
      inset: auto -30% -10% auto;
      width: 115%;
      max-width: 34rem;
      height: 100%;
      opacity: 0.22;
      pointer-events: none;
    }
  }
</style>
