---
import { Image } from 'astro:assets';
import marineDataStudio from '../assets/marine-data-studio.jpg';
import type { Lang } from '../i18n/routes';
import { site } from '../content/site';

interface Props {
  lang: Lang;
}

const t = site[Astro.props.lang];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="subtitle">{t.hero.subtitle}</p>
      <div class="actions">
        <a class="btn btn-primary" href={`#${t.ids.projects}`}>{t.hero.primary}</a>
        <a class="btn btn-ghost" href={`#${t.ids.background}`}>{t.hero.secondary}</a>
      </div>
    </div>
    <figure class="art">
      <Image
        src={marineDataStudio}
        alt={t.hero.illustrationAlt}
        widths={[360, 540, 720, 960, 1280]}
        sizes="(max-width: 52rem) 92vw, 34rem"
        format="webp"
        loading="eager"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 85% 10%, var(--navy-2) 0%, transparent 60%),
      var(--navy);
    color: var(--on-navy);
    /* Compacto: a 1440 × 900 deben verse los títulos de los tres proyectos. */
    padding-block: clamp(1.75rem, 1rem + 2vw, 2.25rem);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    /* La imagen ocupa todo el alto de la columna derecha. */
    align-items: stretch;
  }

  .copy {
    position: relative;
    z-index: 1;
    align-self: center;
  }

  h1 {
    font-size: clamp(2rem, 1.5rem + 1.1vw, 2.3rem);
    margin: 0 0 0.85rem;
    max-width: 36ch;
  }

  .subtitle {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--on-navy-muted);
    max-width: 46rem;
    margin: 0 0 1.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .art {
    margin: 0;
    min-height: 16rem;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
  }

  /* Recorta sin deformar (object-fit: cover) para llenar la columna. */
  .art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .art {
      width: 100%;
      min-height: 0;
    }

    /* En móvil la imagen se muestra entera, con su proporción original. */
    .art :global(img) {
      height: auto;
    }
  }
</style>
