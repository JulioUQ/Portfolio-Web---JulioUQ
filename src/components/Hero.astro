---
import { Image } from 'astro:assets';
import marineDataStudio from '../assets/marine-data-studio.jpg';
import type { Lang } from '../i18n/routes';
import { site } from '../content/site';

interface Props {
  lang: Lang;
}

const t = site[Astro.props.lang];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="subtitle">{t.hero.subtitle}</p>
      <div class="actions">
        <a class="btn btn-primary" href={`#${t.ids.projects}`}>{t.hero.primary}</a>
        <a class="btn btn-ghost" href={`#${t.ids.background}`}>{t.hero.secondary}</a>
      </div>
    </div>
    <figure class="art">
      <Image
        src={marineDataStudio}
        alt={t.hero.illustrationAlt}
        widths={[360, 540, 720, 960]}
        sizes="(max-width: 52rem) min(90vw, 28rem), 30vw"
        format="webp"
        loading="eager"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 85% 10%, var(--navy-2) 0%, transparent 60%),
      var(--navy);
    color: var(--on-navy);
    /* Compacto: a 1440 × 900 deben verse los títulos de los tres proyectos. */
    padding-block: clamp(1.75rem, 1rem + 2vw, 2.25rem);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .copy {
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: clamp(2rem, 1.4rem + 1.6vw, 2.6rem);
    margin: 0 0 1rem;
    max-width: 36ch;
  }

  .subtitle {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    color: var(--on-navy-muted);
    max-width: 46rem;
    margin: 0 0 1.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .art {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .art img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .art {
      width: 100%;
      max-width: 28rem;
    }
  }
</style>
