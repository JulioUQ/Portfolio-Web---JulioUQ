# API del chat del portfolio. Copia este archivo a api/.env (Git lo ignora) y rellena lo necesario.
# Las claves solo viven en el servidor: la web estática nunca las recibe.

# Proveedor: anthropic (modelo real) · test (sin modelo, devuelve los fragmentos recuperados) · vacío = sin configurar
CHAT_PROVIDER=
# Modelo del proveedor (por defecto claude-opus-5-5)
CHAT_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento del modelo: low | medium | high | xhigh | max (por defecto low, suficiente para un chat)
CHAT_EFFORT=low
# Credencial de Anthropic (necesaria con CHAT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Servidor
PORT=8787
HOST=127.0.0.1
# Orígenes de la web que pueden llamar a la API (separados por comas)
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Carpeta con es.json y en.json que genera el build de la web (relativa a api/)
KNOWLEDGE_DIR=../dist/knowledge
# 1 solo si la API está detrás de un proxy de confianza que fija X-Forwarded-For
TRUST_PROXY=0

# Límites
CHAT_MAX_QUESTION_CHARS=500
CHAT_MAX_HISTORY=8
CHAT_MAX_BODY_BYTES=16384
CHAT_RATE_PER_MINUTE=6
CHAT_RATE_PER_DAY=60
